# Variáveis de ambiente do «Balcão». Copia para `.env` e ajusta: `cp .env.example .env`.
# O `.env` nunca entra no repositório (está no .gitignore); este ficheiro sim, sem segredos.

# --- Modelo (adr-0003, adr-0004) -------------------------------------------------
# simulado: sem rede nem chave (testes, CI, primeiro arranque)
# ollama:   llama3.2:3b local (docker compose --profile ollama up)
# anthropic | openai: fornecedor comercial, com versão de modelo fixada (RI-07)
BALCAO_MODELO_FORNECEDOR=simulado
# Modelo que responde (escalão médio). Nos comerciais, usa o identificador com data da página do fornecedor.
BALCAO_MODELO_CHAT=llama3.2:3b
# Escalão pequeno (classificar, reformular). Vazio = o mesmo do chat.
BALCAO_MODELO_CLASSIFICAR=
# Juiz das avaliações (escalão grande, nunca o que responde; adr-0019).
BALCAO_MODELO_JUIZ=

# --- Embeddings (adr-0007) ---------------------------------------------------------
# Vazio = segue o fornecedor do modelo (com anthropic, usa ollama).
BALCAO_EMBEDDINGS_FORNECEDOR=
BALCAO_MODELO_EMBEDDINGS=nomic-embed-text
BALCAO_DIM_EMBEDDINGS=768

# --- Serviços ----------------------------------------------------------------------
# Sem DATABASE_URL, tudo em memória (índice, conversas, checkpoints).
DATABASE_URL=postgresql://balcao:balcao@localhost:5432/balcao
OLLAMA_BASE_URL=http://localhost:11434

# --- Chaves (vazias no repositório; em CI vêm de segredos) ------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- API -----------------------------------------------------------------------------
# token=papel[:cliente]. Só para o laboratório; em produção, JWT do IdP.
BALCAO_TOKENS_API=dev-aida=cliente:CL-77120,dev-nelson=cliente:CL-40311,dev-graca=cliente:CL-90004,dev-supervisor=supervisor,dev-operador=operador

# --- Limites e recuperação ---------------------------------------------------------------
BALCAO_LIMITE_REEMBOLSO_MZN=500
BALCAO_MAX_CHAMADAS_FERRAMENTAS=6
BALCAO_K_CONTEXTO=4
BALCAO_LIMIAR_RELEVANCIA=0.1
# pgvector < 0.8 não tem iterative index scans.
BALCAO_ITERATIVE_SCAN=true

# --- Gate de avaliação (adr-0018) ---------------------------------------------------------
BALCAO_GATE_RECALL=0.80
BALCAO_GATE_FIDELIDADE=0.85
BALCAO_GATE_RECUSA=0.80
BALCAO_GATE_FERRAMENTAS=0.90
BALCAO_GATE_REDTEAM=1.00

# --- Observabilidade ------------------------------------------------------------------------
BALCAO_OTEL_CONSOLA=false
